#!/bin/sh
# {{ ansible_managed }}
# Panel item (xfce4-genmon-plugin): this client's name and IP address.
address=$(ip -4 -o address show scope global | awk '{ split($4, a, "/"); print a[1]; exit }')
echo "<txt> $(hostname) · ${address:-no network} </txt>"
echo "<tool>$(hostname): ${address:-no network}</tool>"
