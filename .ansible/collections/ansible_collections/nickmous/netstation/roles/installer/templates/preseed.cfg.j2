# {{ ansible_managed }}
# Unattended Debian installation for a netstation server.
# Reference: https://www.debian.org/releases/stable/example-preseed.txt

# Language, keyboard
d-i debian-installer/locale string {{ netstation_installer_locale }}
d-i keyboard-configuration/xkb-keymap select {{ netstation_keyboard_layout }}

# Network
d-i netcfg/choose_interface select {{ netstation_installer_interface }}
d-i netcfg/get_hostname string {{ netstation_installer_hostname }}
d-i netcfg/get_domain string {{ netstation_installer_domain }}
d-i netcfg/hostname string {{ netstation_installer_hostname }}
d-i netcfg/wireless_wep string
d-i hw-detect/load_firmware boolean true
{% if netstation_installer_network == 'static' %}
d-i netcfg/disable_autoconfig boolean true
d-i netcfg/get_ipaddress string {{ netstation_installer_address }}
d-i netcfg/get_netmask string {{ netstation_installer_netmask }}
d-i netcfg/get_gateway string {{ netstation_installer_gateway }}
d-i netcfg/get_nameservers string {{ netstation_installer_nameservers | join(' ') }}
d-i netcfg/confirm_static boolean true
{% endif %}

# Package mirror
d-i mirror/country string manual
d-i mirror/http/hostname string {{ netstation_debian_mirror | urlsplit('hostname') }}
d-i mirror/http/directory string {{ netstation_debian_mirror | urlsplit('path') }}
d-i mirror/http/proxy string

# Accounts: no root password, so the admin account gets sudo.
d-i passwd/root-login boolean false
d-i passwd/user-fullname string netstation admin
d-i passwd/username string {{ netstation_installer_admin_user }}
d-i passwd/user-password-crypted password {{ netstation_installer_admin_password | password_hash('sha512') }}

# Clock
d-i clock-setup/utc boolean true
d-i time/zone string {{ netstation_timezone }}
d-i clock-setup/ntp boolean true

# Disk: the whole first disk, one partition plus swap.
d-i partman/early_command string debconf-set partman-auto/disk "$(list-devices disk | head -n 1)"
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-efi/non_efi_system boolean true
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

# Packages: SSH and the basics; Ansible does the rest.
d-i apt-setup/cdrom/set-first boolean false
d-i apt-setup/cdrom/set-next boolean false
d-i apt-setup/cdrom/set-failed boolean false
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/services-select multiselect security, updates
tasksel tasksel/first multiselect standard, ssh-server
d-i pkgsel/include string sudo python3
d-i pkgsel/upgrade select full-upgrade
popularity-contest popularity-contest/participate boolean false

# Boot loader
d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string default

# Finish
d-i preseed/late_command string sh /netstation/late-command.sh
d-i cdrom-detect/eject boolean true
d-i finish-install/reboot_in_progress note
