# {{ ansible_managed }}
# Read by netstation-notify, netstation-health and netstation-client-reports. Contains the Pushover keys.
PUSHOVER_APP_TOKEN={{ netstation_pushover_app_token | quote }}
PUSHOVER_USER_KEY={{ netstation_pushover_user_key | quote }}
NETSTATION_ALERTS_NAME={{ netstation_alerts_name | quote }}
NETSTATION_ALERTS_SERVICES={{ netstation_alerts_services | join(' ') | quote }}
NETSTATION_ALERTS_DISK_PERCENT={{ netstation_alerts_disk_percent | int }}
NETSTATION_BASE_DIR={{ netstation_base_dir | quote }}
NETSTATION_ALERTS_CLIENT_QUIET_MINUTES={{ netstation_alerts_client_quiet_minutes | int }}
