#!/bin/sh
# netstation-image: build, promote and roll back the netstation client image.
# Installed by the nickmous.netstation Ansible collection; settings come from
# /etc/netstation/netstation.env and the build context it renders.
set -eu

# shellcheck source=/dev/null
. /etc/netstation/netstation.env

IMAGES_DIR=$NETSTATION_BASE_DIR/images
CONTEXT_DIR=$NETSTATION_STATE_DIR/context
BUILD_DIR=$NETSTATION_STATE_DIR/build
PROD_IMG=$IMAGES_DIR/$NETSTATION_IMAGE.img
STAGING_IMG=$IMAGES_DIR/$NETSTATION_STAGING_IMAGE.img

die() {
    echo "netstation-image: $*" >&2
    exit 1
}

log() {
    echo "==> $*"
}

usage() {
    cat <<EOF
Usage: netstation-image COMMAND

Commands:
  build              Build a fresh staging image from the current build context
  promote            Make the staging image the production image
  rollback [BUILD]   Restore a previous production image (default: the newest)
  diff [--summary | --dir DIR]
                     Show what changed between production and staging:
                     packages, and the files netstation puts in the image.
                     In a terminal it's colored and paged like git diff.
                     --dir writes both versions to DIR/production and
                     DIR/staging, to open in a diff viewer
  status             Show images, booted clients and services
  clients            List booted clients as "IP MAC", one per line
EOF
}

lock() {
    exec 9>/run/netstation-image.lock
    flock -n 9 || die "another netstation-image command is running"
}

# Print the build id stored inside an image file.
build_id() {
    unsquashfs -cat "$1" etc/netstation-release 2>/dev/null |
        sed -n 's/^NETSTATION_BUILD_ID=//p' | head -n 1 | grep . || echo unknown
}

# Move an image file into the releases folder. Moving (not copying) keeps
# the file open for clients that are still running it.
archive() {
    archive_id=$(build_id "$1")
    archive_dest=$NETSTATION_RELEASES_DIR/$NETSTATION_IMAGE-$archive_id.img
    if [ -e "$archive_dest" ] || [ "$archive_id" = unknown ]; then
        archive_dest=$NETSTATION_RELEASES_DIR/$NETSTATION_IMAGE-$archive_id-$(date -u +%Y%m%dT%H%M%SZ).img
    fi
    mkdir -p "$NETSTATION_RELEASES_DIR"
    mv "$1" "$archive_dest"
    log "Archived production build $archive_id as $(basename "$archive_dest")"
}

# Remove archived copies of a build that is now in production, so it isn't
# offered as a rollback target.
drop_release() {
    [ "$1" != unknown ] || return 0
    for copy in "$NETSTATION_RELEASES_DIR/$NETSTATION_IMAGE-$1.img" \
        "$NETSTATION_RELEASES_DIR/$NETSTATION_IMAGE-$1-"*.img; do
        [ -f "$copy" ] || continue
        rm -f -- "$copy"
        log "Removed $(basename "$copy"), the same build as production"
    done
}

# Newest first.
list_releases() {
    find "$NETSTATION_RELEASES_DIR" -maxdepth 1 -name "$NETSTATION_IMAGE-*.img" \
        -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-
}

prune_releases() {
    list_releases | tail -n +"$((NETSTATION_RELEASES_KEEP + 1))" | while read -r old; do
        rm -f -- "$old"
        log "Removed old release $(basename "$old")"
    done
}

# Extract the production kernel and regenerate the boot menu.
publish() {
    ltsp kernel "$PROD_IMG"
    ltsp --overwrite ipxe
}

cmd_build() {
    [ -f "$CONTEXT_DIR/build.env" ] ||
        die "no build context in $CONTEXT_DIR; run the image_build playbook first"
    # shellcheck source=/dev/null
    . "$CONTEXT_DIR/build.env"

    recommends=false
    [ "$NETSTATION_INSTALL_RECOMMENDS" = 1 ] && recommends=true
    packages=$(grep -v '^#' "$CONTEXT_DIR/packages" | grep . | paste -sd, -)
    target=$BUILD_DIR/$NETSTATION_STAGING_IMAGE

    mkdir -p "$BUILD_DIR"
    rm -rf "$target.new"
    # The files netstation adds, so `diff` can compare them between builds.
    (cd "$CONTEXT_DIR/rootfs" && find . -type f | sed 's|^\./||' | LC_ALL=C sort) \
        >"$BUILD_DIR/netstation-files"
    log "Building $NETSTATION_STAGING_IMAGE from scratch"
    log "[1/4] Installing Debian $NETSTATION_SUITE and $(echo "$packages" | tr ',' '\n' | wc -l) packages (the longest step)"
    # shellcheck disable=SC2016 # $1 is expanded by mmdebstrap's hook shell
    mmdebstrap --mode=root --variant=minbase \
        --aptopt="APT::Install-Recommends \"$recommends\"" \
        --include="$packages" \
        --customize-hook='echo "==> [2/4] Configuring the image"' \
        --customize-hook="sync-in $CONTEXT_DIR/rootfs /" \
        --customize-hook="copy-in $BUILD_DIR/netstation-files /etc" \
        --customize-hook='chroot "$1" /usr/local/sbin/netstation-image-setup' \
        "$NETSTATION_SUITE" "$target.new" "$CONTEXT_DIR/sources.list"
    rm -rf "$target"
    mv "$target.new" "$target"

    log "[3/4] Packing the image"
    ltsp image --backup=0 --mksquashfs-params="$NETSTATION_SQUASHFS_PARAMS" "$target"
    log "[4/4] Updating the boot menu"
    ltsp --overwrite ipxe
    log "Staging build $(build_id "$STAGING_IMG") is ready. Test it, then run: netstation-image promote"
}

# Installed packages in an image as "name version", sorted.
packages() {
    unsquashfs -cat "$1" var/lib/dpkg/status 2>/dev/null | awk '
        BEGIN { RS = ""; FS = "\n" }
        {
            name = version = status = ""
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^Package: /) name = substr($i, 10)
                else if ($i ~ /^Version: /) version = substr($i, 10)
                else if ($i ~ /^Status: /) status = substr($i, 9)
            }
            if (status == "install ok installed") print name, version
        }' | LC_ALL=C sort
}

# One line per changed package: "updated|added|removed name old new".
package_changes() {
    packages "$PROD_IMG" >"$1/production.packages"
    packages "$STAGING_IMG" >"$1/staging.packages"
    LC_ALL=C join -a 1 -a 2 -e - -o 0,1.2,2.2 \
        "$1/production.packages" "$1/staging.packages" |
        awk '$2 == "-" { print "added", $0; next }
             $3 == "-" { print "removed", $0; next }
             $2 != $3 { print "updated", $0 }'
}

# The files netstation added to either image. Builds from before this list
# existed fall back to the current build context.
netstation_files() {
    for img in "$PROD_IMG" "$STAGING_IMG"; do
        unsquashfs -cat "$img" etc/netstation-files 2>/dev/null || true
    done | LC_ALL=C sort -u | grep . ||
        (cd "$CONTEXT_DIR/rootfs" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)
}

# One line per changed netstation file: "changed|added|removed path".
file_changes() {
    netstation_files | while read -r path; do
        old=$1/production.file
        new=$1/staging.file
        unsquashfs -cat "$PROD_IMG" "$path" >"$old" 2>/dev/null || rm -f "$old"
        unsquashfs -cat "$STAGING_IMG" "$path" >"$new" 2>/dev/null || rm -f "$new"
        if [ ! -e "$old" ]; then
            echo "added $path"
        elif [ ! -e "$new" ]; then
            echo "removed $path"
        elif ! cmp -s "$old" "$new"; then
            echo "changed $path"
        fi
    done
}

cmd_diff() {
    case "${1:-}" in
    "" | --summary | --dir) ;;
    *) die "unknown option for diff: $1 (see: netstation-image help)" ;;
    esac
    [ -f "$STAGING_IMG" ] || die "there is no staging image; build one first"
    [ -f "$PROD_IMG" ] || die "there is no production image to compare with"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    package_changes "$tmp" >"$tmp/packages"
    file_changes "$tmp" >"$tmp/files"

    if [ "${1:-}" = --summary ]; then
        echo "Staging $(build_id "$STAGING_IMG") compared with production $(build_id "$PROD_IMG"):"
        echo "$(grep -c '^updated' "$tmp/packages") packages updated," \
            "$(grep -c '^added' "$tmp/packages") added," \
            "$(grep -c '^removed' "$tmp/packages") removed;" \
            "$(wc -l <"$tmp/files") netstation files changed."
        grep '^updated' "$tmp/packages" | awk '{ print $2 }' | head -n 15 | paste -sd ' ' - |
            sed 's/^/Updated: /; /^Updated: $/d'
        awk '{ print $2 }' "$tmp/files" | paste -sd ' ' - | sed 's/^/Files: /; /^Files: $/d'
        return 0
    fi

    if [ "${1:-}" = --dir ]; then
        export_diff "${2:?usage: netstation-image diff --dir DIR}"
        return 0
    fi

    # Like git diff: colored and paged in a terminal, plain otherwise.
    if [ -t 1 ]; then
        diff_report "$tmp" | colorize | ${PAGER:-less -FRX}
    else
        diff_report "$tmp"
    fi
}

# Writes the changed files of both images, and their package lists, to
# DIR/production and DIR/staging.
export_diff() {
    for side in production staging; do
        rm -rf "${1:?}/$side"
        mkdir -p "$1/$side"
    done
    packages "$PROD_IMG" >"$1/production/packages.txt"
    packages "$STAGING_IMG" >"$1/staging/packages.txt"
    awk '{ print $2 }' "$tmp/files" | while read -r path; do
        for side in production staging; do
            img=$PROD_IMG
            [ "$side" = staging ] && img=$STAGING_IMG
            mkdir -p "$1/$side/$(dirname "$path")"
            unsquashfs -cat "$img" "$path" >"$1/$side/$path" 2>/dev/null || rm -f "$1/$side/$path"
        done
    done
    # Readable without root by whoever ran sudo.
    if [ -n "${SUDO_USER:-}" ]; then
        chown -R "$SUDO_USER:" "$1"
    fi
    echo "Wrote $(wc -l <"$tmp/files") changed files and the package lists to $1"
    echo "Copy the folder to your own machine and open it in a diff viewer, e.g.:"
    echo "  scp -r $(hostname):$1 . && git diff --no-index $(basename "$1")/production $(basename "$1")/staging"
    echo "  meld $(basename "$1")/production $(basename "$1")/staging"
    echo "or open $1 on the server with VS Code's Remote-SSH."
}

# Colors for the terminal, like git diff. NO_COLOR turns them off.
colorize() {
    if [ -n "${NO_COLOR:-}" ]; then
        cat
        return
    fi
    esc=$(printf '\033')
    sed -e "s/^\(Staging build .*\|Packages\|Files from netstation\)$/${esc}[1m&${esc}[0m/" \
        -e "s/^\(      +++ .*\|      --- .*\)$/${esc}[1m&${esc}[0m/" \
        -e "s/^      @@.*/${esc}[36m&${esc}[0m/" \
        -e "s/^      +.*/${esc}[32m&${esc}[0m/" \
        -e "s/^      -.*/${esc}[31m&${esc}[0m/" \
        -e "s/^  \(added\) /  ${esc}[32m\1${esc}[0m /" \
        -e "s/^  \(removed\) /  ${esc}[31m\1${esc}[0m /" \
        -e "s/^  \(updated\|changed\) /  ${esc}[33m\1${esc}[0m /"
}

diff_report() {
    tmp=$1
    echo "Staging build $(build_id "$STAGING_IMG") compared with production build $(build_id "$PROD_IMG")"
    echo
    echo "Packages"
    if [ -s "$tmp/packages" ]; then
        while read -r change name old new; do
            case $change in
            updated) printf '  updated  %s %s -> %s\n' "$name" "$old" "$new" ;;
            added) printf '  added    %s %s\n' "$name" "$new" ;;
            removed) printf '  removed  %s %s\n' "$name" "$old" ;;
            esac
        done <"$tmp/packages"
    else
        echo "  no changes"
    fi
    echo
    echo "Files from netstation"
    if [ -s "$tmp/files" ]; then
        while read -r change path; do
            printf '  %-8s %s\n' "$change" "$path"
            [ "$change" = changed ] || continue
            unsquashfs -cat "$PROD_IMG" "$path" >"$tmp/old" 2>/dev/null
            unsquashfs -cat "$STAGING_IMG" "$path" >"$tmp/new" 2>/dev/null
            if grep -qI . "$tmp/old" && grep -qI . "$tmp/new"; then
                diff -u --label "production/$path" --label "staging/$path" \
                    "$tmp/old" "$tmp/new" | sed 's/^/      /' || true
            else
                echo "      (binary file)"
            fi
        done <"$tmp/files"
    else
        echo "  no changes"
    fi
}

cmd_promote() {
    [ -f "$STAGING_IMG" ] || die "there is no staging image; build one first"
    new_id=$(build_id "$STAGING_IMG")
    if [ -f "$PROD_IMG" ]; then
        old_id=$(build_id "$PROD_IMG")
        if [ "$new_id" != unknown ] && [ "$new_id" = "$old_id" ]; then
            die "staging build $new_id is already in production"
        fi
        archive "$PROD_IMG"
    fi
    log "Promoting staging build $new_id to production"
    cp --reflink=auto "$STAGING_IMG" "$PROD_IMG.tmp"
    mv "$PROD_IMG.tmp" "$PROD_IMG"
    drop_release "$new_id"
    publish
    prune_releases
    log "Production is now build $new_id. Clients pick it up on their next boot."
}

cmd_rollback() {
    if [ $# -gt 0 ]; then
        target=$NETSTATION_RELEASES_DIR/$NETSTATION_IMAGE-${1#"$NETSTATION_IMAGE"-}
        target=${target%.img}.img
    else
        target=$(list_releases | head -n 1)
    fi
    [ -n "$target" ] && [ -f "$target" ] ||
        die "release not found; see the list in: netstation-image status"
    rollback_id=$(build_id "$target")
    if [ -f "$PROD_IMG" ]; then
        archive "$PROD_IMG"
    fi
    mv "$target" "$PROD_IMG"
    drop_release "$rollback_id"
    publish
    log "Production is now build $rollback_id. Clients pick it up on their next boot."
}

# Clients that are on: those that checked in during the last 5 minutes
# (netstation-heartbeat, every 2 minutes), plus those reading the image over
# NFS right now (images from before the heartbeat). An idle client closes its
# NFS connection after a few minutes, so NFS alone misses idle clients.
cmd_clients() {
    {
        awk -v since="$(($(date +%s) - 300))" '$1 >= since && $3 != "" { print $2, $3 }' \
            /var/log/nginx/netstation-alive.log 2>/dev/null
        ss -Htn state established '( sport = :2049 )' | awk '{print $4}' |
            sed 's/^\[::ffff://; s/\]\{0,1\}:[0-9]*$//' | sort -u |
            while read -r ip; do
                mac=$(ip neigh show "$ip" | awk '{ for (i = 1; i < NF; i++) if ($i == "lladdr") print $(i + 1) }')
                echo "$ip ${mac:-unknown}"
            done
    } | awk '{ ip[$2] = $1 } END { for (mac in ip) print ip[mac], mac }' | sort -V
}

describe() {
    if [ -f "$1" ]; then
        echo "build $(build_id "$1"), $(du -h "$1" | cut -f1)"
    else
        echo "none"
    fi
}

cmd_status() {
    echo "Images"
    printf '  %-12s %s\n' production "$(describe "$PROD_IMG")"
    printf '  %-12s %s\n' staging "$(describe "$STAGING_IMG")"
    echo
    echo "Previous production builds (rollback targets, newest first)"
    releases=$(list_releases)
    if [ -n "$releases" ]; then
        echo "$releases" | while read -r img; do
            printf '  %s\n' "$(build_id "$img")"
        done
    else
        echo "  none"
    fi
    echo
    echo "Scheduled staging build"
    printf '  timer: %s, next: %s\n' \
        "$(systemctl is-enabled netstation-staging-build.timer 2>/dev/null || true)" \
        "$(systemctl show -P NextElapseUSecRealtime netstation-staging-build.timer 2>/dev/null || true)"
    if [ -n "$(systemctl show -P ExecMainStartTimestamp netstation-staging-build.service 2>/dev/null)" ]; then
        last_run=$(systemctl show -P Result netstation-staging-build.service)
    else
        last_run=never
    fi
    printf '  last run: %s\n' "$last_run"
    echo
    echo "Clients booted from this server"
    clients=$(cmd_clients)
    if [ -n "$clients" ]; then
        echo "$clients" | sed 's/^/  /'
    else
        echo "  none"
    fi
    echo
    echo "Services"
    for service in dnsmasq nfs-server nginx; do
        printf '  %-12s %s\n' "$service" "$(systemctl is-active "$service" 2>/dev/null || true)"
    done
}

[ "$(id -u)" = 0 ] || die "run as root (sudo netstation-image ...)"
command=${1:-}
if [ $# -gt 0 ]; then shift; fi
case "$command" in
build)
    lock
    cmd_build
    ;;
promote)
    lock
    cmd_promote
    ;;
rollback)
    lock
    cmd_rollback "$@"
    ;;
diff) cmd_diff "$@" ;;
status) cmd_status ;;
clients) cmd_clients ;;
-h | --help | help) usage ;;
*)
    usage >&2
    exit 1
    ;;
esac
