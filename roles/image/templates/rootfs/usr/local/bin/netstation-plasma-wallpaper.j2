#!/bin/sh
# {{ ansible_managed }}
# Plasma: sets the netstation wallpaper on every screen. The home folder is
# fresh at every login, so this runs at every login. plasmashell may still be
# starting, so it tries for up to a minute.
wallpaper=/usr/share/backgrounds/netstation/{{ netstation_wallpaper_file | quote }}
for _ in $(seq 30); do
    plasma-apply-wallpaperimage "$wallpaper" >/dev/null 2>&1 && exit 0
    sleep 2
done
logger -t netstation-wallpaper -- "plasma-apply-wallpaperimage $wallpaper failed"
