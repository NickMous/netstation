#!/bin/bash
# {{ ansible_managed }}
# Opens an .rdp file in xfreerdp3 and asks for the password in a dialog.
# xfreerdp3's output goes to the journal (journalctl -t netstation-rdp); a
# crash or an error is reported to the server with netstation-report.
set -u

# The dialog texts, from netstation_rdp_messages.
{% for key in ['title', 'wrong_password', 'crashed', 'account_blocked', 'password_expired', 'unreachable', 'failed'] %}
msg_{{ key }}={{ netstation_rdp_messages[key] | quote }}
{% endfor %}

file=$1

# .rdp files saved on Windows are usually UTF-16.
if head -c 2 "$file" | od -An -tx1 | grep -qE 'ff fe|fe ff'; then
    content=$(iconv -f UTF-16 -t UTF-8 "$file")
else
    content=$(cat "$file")
fi
setting() {
    printf '%s\n' "$content" | tr -d '\r' | grep -i -m 1 "^$1:s:" | cut -d: -f3-
}
user=$(setting username)
address=$(setting 'full address')

pass=$(zenity --password --title="$msg_title${user:+ - $user}") || exit 0

log=$(mktemp)
trap 'rm -f "$log"' EXIT

# Through perl, to tell a crash (killed by a signal) from xfreerdp3's own exit
# codes, which also go above 128. Prints "exit CODE" or "signal NUMBER".
result=$(perl -e '
    open my $result, ">&", \*STDOUT or die;
    open STDOUT, ">", shift or die;
    open STDERR, ">&", \*STDOUT or die;
    system { $ARGV[0] } @ARGV;
    print $result $? == -1 ? "exit 127" : $? & 127 ? "signal " . ($? & 127) : "exit " . ($? >> 8);
' "$log" xfreerdp3 "$file" /p:"$pass" {{ (netstation_rdp_redirect_options + netstation_rdp_options) | map('quote') | join(' ') }})
code=${result#* }
systemd-cat -t netstation-rdp <"$log"
logger -t netstation-rdp -- "xfreerdp3 to ${address:-?} as ${user:-?}: $result"

# The last errors and warnings, without the timestamps.
errors() {
    { grep -E '\[(ERROR|FATAL|WARN)\]' "$log" || cat "$log"; } |
        sed 's/^\[[^]]*\] \[[^]]*\] //' | tail -n 8
}

# Exit codes from FreeRDP's client/X11/xfreerdp.h.
case $result in
"exit 0" | "exit 1" | "exit 2" | "exit 3" | "exit 5" | "exit 11" | "exit 145")
    # Disconnected or logged off normally, or cancelled.
    exit 0
    ;;
"exit 132" | "exit 134" | "exit 154" | "exit 159")
    zenity --error --no-markup --title="$msg_title" --text="$msg_wrong_password"
    exit 0
    ;;
signal*)
    kind=crash
    title="Remote Desktop crashed"
    problem="xfreerdp3 crashed (signal $code, $(kill -l "$code" 2>/dev/null || echo unknown))."
    text=$msg_crashed
    ;;
"exit 135" | "exit 151" | "exit 157")
    kind=error
    title="Remote Desktop account blocked"
    problem="The account is locked out, disabled or expired (exit code $code)."
    text=$msg_account_blocked
    ;;
"exit 148" | "exit 149" | "exit 152")
    kind=error
    title="Remote Desktop password expired"
    problem="The password has expired or must be changed (exit code $code)."
    text=$msg_password_expired
    ;;
"exit 131" | "exit 139" | "exit 140" | "exit 141" | "exit 143" | "exit 147")
    kind=error
    title="Remote Desktop can't connect"
    problem="Couldn't reach the remote computer (exit code $code)."
    text=$msg_unreachable
    ;;
*)
    kind=error
    title="Remote Desktop error"
    problem="xfreerdp3 stopped with exit code $code."
    text=$msg_failed
    ;;
esac

details="$problem Server: ${address:-?}, user: ${user:-?}.
Shown: $text
$(errors)"
# In the background, so the dialog shows right away.
netstation-report "$kind" "$title" "$details" &
zenity --error --no-markup --title="$msg_title" --text="$text"
