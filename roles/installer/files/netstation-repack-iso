#!/bin/sh
# Repacks a Debian netinst ISO into an unattended installer:
#   netstation-repack-iso SOURCE.iso WORKDIR OUTPUT.iso
# WORKDIR/overlay holds preseed.cfg and the netstation/ folder; both are
# appended to the installer's initrd, which reads /preseed.cfg on start.
set -eu

src=$1
work=$2
out=$3

cd "$work"

xorriso -osirrox on -indev "$src" -extract /install.amd/initrd.gz initrd.gz
chmod u+w initrd.gz
# An initrd may consist of several compressed cpio archives in a row.
(cd overlay && find . | cpio -o -H newc -R 0:0 --quiet) | gzip -9 >>initrd.gz

append="auto=true priority=critical"

# UEFI menu: Debian's own header (fonts, graphics mode; without it UEFI
# machines such as Hyper-V Generation 2 VMs can stay black), then only our
# entry instead of Debian's menu.
xorriso -osirrox on -indev "$src" -extract /boot/grub/grub.cfg grub.orig.cfg
sed '/^menuentry/,$d' grub.orig.cfg >grub.cfg
cat >>grub.cfg <<GRUB
set timeout=3
set default=0
menuentry "Install netstation server (erases the disk)" {
    set background_color=black
    linux /install.amd/vmlinuz $append vga=788 --- quiet
    initrd /install.amd/initrd.gz
}
GRUB

cat >isolinux.cfg <<ISOLINUX
default netstation
prompt 0
timeout 30
label netstation
    kernel /install.amd/vmlinuz
    append initrd=/install.amd/initrd.gz $append vga=788 --- quiet
ISOLINUX

set -- -map initrd.gz /install.amd/initrd.gz -map grub.cfg /boot/grub/grub.cfg
# BIOS boot (isolinux) is optional; UEFI-only images don't have it.
if xorriso -indev "$src" -ls /isolinux/isolinux.cfg >/dev/null 2>&1; then
    set -- "$@" -map isolinux.cfg /isolinux/isolinux.cfg
fi

mkdir -p "$(dirname "$out")"
rm -f "$out.tmp"
xorriso -indev "$src" -outdev "$out.tmp" "$@" -boot_image any replay
mv "$out.tmp" "$out"
