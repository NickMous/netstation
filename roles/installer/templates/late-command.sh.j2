#!/bin/sh
# Runs at the end of the installation; the new system is mounted at /target.
set -e
user={{ netstation_installer_admin_user | quote }}

mkdir -p "/target/home/$user/.ssh"
cp /netstation/authorized_keys "/target/home/$user/.ssh/authorized_keys"
chmod 0700 "/target/home/$user/.ssh"
chmod 0600 "/target/home/$user/.ssh/authorized_keys"
in-target chown -R "$user:$user" "/home/$user/.ssh"

for file in /netstation/interfaces.d/*; do
    [ -e "$file" ] || continue
    cp "$file" /target/etc/network/interfaces.d/
done
