# {{ ansible_managed }}
[Interface]
Address = {{ netstation_wireguard_address }}
ListenPort = {{ netstation_wireguard_port }}
PrivateKey = {{ netstation_wireguard_private_key }}
{% if netstation_wireguard_masquerade %}
PostUp = /usr/sbin/nft add table ip netstation_wg
PostUp = /usr/sbin/nft 'add chain ip netstation_wg postrouting { type nat hook postrouting priority 100; }'
PostUp = /usr/sbin/nft add rule ip netstation_wg postrouting ip saddr {{ netstation_wireguard_network }} oifname "{{ netstation_wireguard_lan_interface }}" masquerade
PostDown = /usr/sbin/nft delete table ip netstation_wg
{% endif %}
{% for peer in netstation_wireguard_peers %}

[Peer]
# {{ peer.name }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.address }}
{% endfor %}
